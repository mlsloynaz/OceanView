# Shared dev defaults (safe to commit — no secrets).
# Personal overrides: copy .env.development.local.example → .env.development.local
VITE_API_BASE_URL=/api
VITE_USE_MOCK_CANDLES=false
VITE_USE_MOCK_MARKET=true
VITE_USE_MOCK_PREMARKET=true

# Vite dev proxy target (also set by scripts/dev-local.ps1).
# Default in vite.config.ts is deployed API Gateway if unset.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001
