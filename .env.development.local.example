# Copy to .env.development.local (gitignored) for personal dev overrides.
# Vite loads this automatically in `npm run dev`.

# Local SAM API (npm run dev:local sets this automatically)
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001

# dev:local sets VITE_USE_MOCK_MARKET=false automatically.
# Optional: mock Market JSON without API (Assess updates time label only)
# VITE_USE_MOCK_MARKET=true
